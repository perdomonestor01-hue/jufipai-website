---
import Base from '../layouts/Base.astro';
import ContentCard from '../components/ContentCard.astro';
import { fetchArticles } from '../lib/api';

const articles = await fetchArticles();
// No posts yet ([] in public/data/articles.json): show one line instead of filters, search and an empty grid.
const hasPosts = articles.length > 0;
---

<Base
  title="Writing"
  description="Articles, questions, and takes on AI and automation for real businesses."
>
  <section class="writing-page">
    <div class="writing-inner">
      <header class="writing-header">
        <h1>Writing</h1>
        {hasPosts && <span class="writing-count">{articles.length} posts</span>}
      </header>

      {!hasPosts && <p class="first-post">First article coming this week.</p>}

      {hasPosts && (<Fragment>
      <div class="writing-controls">
        <div
          class="filter-group"
          role="group"
          aria-label="Filter by content type"
        >
          <button
            class="filter-btn active"
            data-filter="all"
            data-filter-index="0"
            type="button"
            aria-pressed="true">All</button
          >
          <button
            class="filter-btn"
            data-filter="article"
            data-filter-index="1"
            type="button"
            aria-pressed="false">Articles</button
          >
          <button
            class="filter-btn"
            data-filter="deep_question"
            data-filter-index="2"
            type="button"
            aria-pressed="false">Questions</button
          >
          <button
            class="filter-btn"
            data-filter="unpopular_take"
            data-filter-index="3"
            type="button"
            aria-pressed="false">Takes</button
          >
          <button
            class="filter-btn"
            data-filter="image_quote"
            data-filter-index="4"
            type="button"
            aria-pressed="false">Thoughts</button
          >
          <button
            class="filter-btn"
            data-filter="tip"
            data-filter-index="5"
            type="button"
            aria-pressed="false">Tips</button
          >
        </div>

        <div class="search-box">
          <input
            type="search"
            id="article-search"
            aria-label="Search posts"
            placeholder="Search posts..."
            autocomplete="off"
          />
        </div>
      </div>

      <div class="articles-grid" id="articles-grid">
        {
          articles.map((article, i) => (
            <div
              class="article-item"
              data-type={article.contentType}
              data-title={article.title.toLowerCase()}
              data-teaser={article.teaser.toLowerCase()}
              style={`--card-index: ${i % 12}`}
              hidden={i >= 12}
            >
              <ContentCard article={article} />
            </div>
          ))
        }
      </div>

      <p
        class="empty-state"
        id="empty-state"
        role="status"
        hidden
      >
        No posts match.
      </p>

      <button
        type="button"
        class="load-more-btn"
        id="load-more">Load more</button
      >
      </Fragment>)}
    </div>
  </section>
</Base>

<script>
  function initWriting(): void {
    const grid = document.getElementById('articles-grid');
    if (!grid) return;

    const ITEMS_PER_PAGE = 12;
    let visibleCount = ITEMS_PER_PAGE;
    let activeFilter = 'all';
    let searchQuery = '';
    let prevFilterIndex = 0;

    function applyFilters() {
      const items = Array.from(
        grid!.querySelectorAll('.article-item')
      ) as HTMLElement[];
      let shown = 0;
      let totalMatches = 0;

      items.forEach((item) => {
        const type = item.dataset.type || '';
        const title = item.dataset.title || '';
        const teaser = item.dataset.teaser || '';

        const matchesFilter =
          activeFilter === 'all' || type === activeFilter;
        const matchesSearch =
          !searchQuery ||
          title.includes(searchQuery) ||
          teaser.includes(searchQuery);

        if (matchesFilter && matchesSearch) {
          totalMatches++;
          if (shown < visibleCount) {
            item.hidden = false;
            item.style.setProperty('--card-index', String(shown));
            shown++;
          } else {
            item.hidden = true;
          }
        } else {
          item.hidden = true;
        }
      });

      const emptyEl = document.getElementById('empty-state');
      const loadBtn = document.getElementById('load-more');

      if (emptyEl) emptyEl.hidden = totalMatches > 0;
      if (loadBtn) loadBtn.hidden = shown >= totalMatches;
    }

    function triggerCrossFade(newIndex: number) {
      const direction = newIndex > prevFilterIndex ? '-12px' : '12px';
      const items = grid!.querySelectorAll('.article-item:not([hidden])');
      items.forEach((item) => {
        const el = item as HTMLElement;
        el.style.setProperty('--slide-direction', direction);
        el.classList.remove('grid-cross-fade');
        void el.offsetWidth; // force reflow
        el.classList.add('grid-cross-fade');
      });
      prevFilterIndex = newIndex;
    }

    document.querySelectorAll('.filter-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        const newIndex = parseInt((btn as HTMLElement).dataset.filterIndex || '0', 10);
        document.querySelectorAll('.filter-btn').forEach((b) => {
          b.classList.remove('active');
          b.setAttribute('aria-pressed', 'false');
        });
        btn.classList.add('active');
        btn.setAttribute('aria-pressed', 'true');
        activeFilter =
          (btn as HTMLElement).dataset.filter || 'all';
        visibleCount = ITEMS_PER_PAGE;
        applyFilters();
        triggerCrossFade(newIndex);
      });
    });

    const searchInput = document.getElementById(
      'article-search'
    ) as HTMLInputElement;
    let debounceTimer: ReturnType<typeof setTimeout>;

    searchInput?.addEventListener('input', () => {
      clearTimeout(debounceTimer);
      debounceTimer = setTimeout(() => {
        searchQuery = searchInput.value.toLowerCase().trim();
        visibleCount = ITEMS_PER_PAGE;
        applyFilters();
      }, 300);
    });

    document
      .getElementById('load-more')
      ?.addEventListener('click', () => {
        visibleCount += ITEMS_PER_PAGE;
        applyFilters();
      });

    applyFilters();
  }

  initWriting();
</script>

<style>
  .writing-page {
    padding: calc(var(--nav-height) + var(--space-xl)) 0 var(--space-xl);
  }

  .writing-inner {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0 var(--space-md);
  }

  .writing-header {
    margin-bottom: var(--space-xl);
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-md);
  }

  .writing-header h1 {
    font-family: var(--font-display);
    font-size: var(--text-display);
    margin: 0;
    line-height: 1;
    color: var(--brand-navy);
  }

  .writing-count {
    font-family: var(--font-mono);
    font-size: var(--text-small);
    color: var(--text-muted);
  }

  .writing-controls {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-md);
    margin-bottom: var(--space-lg);
    flex-wrap: wrap;
  }

  /* filters wrap on a phone; every button is a 44px target */
  .filter-group {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
  }

  .filter-btn {
    font-family: var(--font-body);
    font-size: var(--text-small);
    font-weight: 500;
    padding: 0.45rem 1rem;
    min-height: 44px;
    border: 1.5px solid #8a8f9c;
    background: transparent;
    color: var(--brand-navy);
    border-radius: var(--radius-pill);
    cursor: pointer;
    transition: background var(--duration-base) var(--ease-spring), border-color var(--duration-base) var(--ease-spring), color var(--duration-base) var(--ease-spring);
  }

  .filter-btn:hover {
    border-color: var(--brand-navy);
    color: var(--brand-navy);
  }

  /* active filter = gold fill, navy text (white on gold fails AA) */
  .filter-btn.active {
    background: var(--brand-gold);
    border-color: var(--brand-gold);
    color: var(--brand-navy);
  }

  .search-box input {
    font-family: var(--font-body);
    font-size: var(--text-small);
    padding: 0.55rem 0.9rem;
    min-height: 44px;
    box-sizing: border-box;
    border: 1.5px solid #8a8f9c;
    border-radius: 12px;
    background: var(--color-surface);
    color: var(--color-carbon);
    width: 240px;
    transition: border-color var(--duration-base) var(--ease-spring), box-shadow var(--duration-base) var(--ease-spring);
  }

  .search-box input:focus {
    border-color: var(--brand-navy);
    box-shadow: 0 0 0 3px rgba(197, 164, 78, .45);
  }

  /* cards render at full opacity, as in the approved screenshots (no scroll-driven fade) */
  .articles-grid :global(.card) {
    animation: none;
  }

  /* empty state: one line in the card-area styling */
  .first-post {
    background: var(--color-surface);
    border: 1px solid var(--color-arena);
    border-radius: var(--radius-card);
    padding: var(--space-lg);
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--brand-navy);
    max-width: 40rem;
  }

  .articles-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-md);
  }

  .empty-state {
    text-align: center;
    color: var(--color-carbon-soft);
    padding: var(--space-2xl) 0;
    font-family: var(--font-display);
    font-style: italic;
    font-size: 1.25rem;
    position: relative;
  }

  .empty-state::after {
    content: '';
    display: block;
    width: 8px;
    height: 8px;
    border-radius: var(--radius-pill);
    background: var(--brand-gold);
    margin: 0.75rem auto 0;
    animation: emptyPulse 1.6s var(--ease-spring) infinite;
  }

  @keyframes emptyPulse {
    0%, 100% { opacity: 0.4; transform: scale(1); }
    50%      { opacity: 1;   transform: scale(1.3); }
  }

  .load-more-btn {
    display: block;
    margin: var(--space-xl) auto 0;
    font-family: var(--font-body);
    font-size: var(--text-small);
    font-weight: 500;
    padding: 0.65rem 1.75rem;
    min-height: 44px;
    border: 1.5px solid #8a8f9c;
    background: var(--color-surface);
    color: var(--color-carbon);
    border-radius: var(--radius-pill);
    cursor: pointer;
    transition: border-color var(--duration-base) var(--ease-spring), color var(--duration-base) var(--ease-spring), transform var(--duration-base) var(--ease-spring);
  }

  .load-more-btn:hover {
    border-color: var(--brand-navy);
    color: var(--brand-navy);
    transform: translateY(-1px);
  }

  @media (max-width: 900px) {
    .articles-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 640px) {
    /* phone header wraps to two rows (lockup + CTA/EN, then nav): ~140px measured */
    .writing-page {
      padding-top: calc(140px + var(--space-lg));
    }

    .articles-grid {
      grid-template-columns: 1fr;
    }

    .search-box input {
      width: 100%;
    }

    .writing-controls {
      flex-direction: column;
      align-items: stretch;
    }
  }
</style>
