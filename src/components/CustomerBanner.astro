---
// "Trusted by" customer banner — the LAST section of the homepage, right above the footer
// (/ and /es/ only; book-call prototype rev 3 moved it here from under the hero).
// The ONLY place customers are named on the site. Entries are operator-confirmed (2026-11-11).
// One tone for every entry (monochrome navy on a light band, no colour logos, nothing linked):
//  - logo entry: the official white logo (white on transparent, 453x310) used as a CSS mask,
//    so it renders in exact brand navy; role="img" + aria-label carry the name.
//  - text entries: the site serif at the logo's visual weight, with a small descriptor.
// Light band on purpose: it must read as distinct from the navy footer directly below it.
import type { Lang } from '../data/home';

interface Props {
  lang?: Lang;
}

const { lang = 'en' } = Astro.props;

type Entry =
  | { kind: 'logo'; name: string; src: string; w: number; h: number }
  | { kind: 'text'; name: string; note: { en: string; es: string } };

const CUSTOMERS: Entry[] = [
  { kind: 'logo', name: 'Custom Workforce Solutions LLC', src: '/brand/customers/cws-logo-white-cropped.png', w: 453, h: 310 },
  { kind: 'text', name: 'Lore Ramirez', note: { en: 'Property Manager · TX', es: 'Administradora de propiedades · TX' } },
  { kind: 'text', name: 'Davilla Maintenance LLC', note: { en: 'Maintenance', es: 'Mantenimiento' } },
];
---

<section class="customers" aria-labelledby="customers-h">
  <h2 class="customers-label" id="customers-h">{lang === 'es' ? 'Con la confianza de' : 'Trusted by'}</h2>
  <ul class="customers-row">
    {CUSTOMERS.map((c) => (
      <li class="customers-slot">
        {c.kind === 'logo' ? (
          <span
            class="customers-logo"
            role="img"
            aria-label={c.name}
            style={`--logo:url(${c.src});aspect-ratio:${c.w}/${c.h}`}
          />
        ) : (
          <span class="customers-text">
            <span class="customers-name">{c.name}</span>
            <span class="customers-note">{c.note[lang]}</span>
          </span>
        )}
      </li>
    ))}
  </ul>
</section>

<style>
  /* light band (white), thin gold hairline on top, navy text — distinct from the navy footer below */
  .customers {
    background: var(--color-surface);
    position: relative;
    padding: var(--space-lg) var(--space-md) var(--space-xl);
    text-align: center;
    border-top: 1px solid var(--color-arena);
  }

  .customers::before {
    content: "";
    position: absolute;
    top: -1px;
    left: 0;
    right: 0;
    height: 1px;
    background: var(--brand-gold-line);
  }

  .customers-label {
    margin: 0 0 var(--space-md);
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: .14em;
    text-transform: uppercase;
    line-height: 1.7;
    color: var(--color-carbon-soft);
  }

  .customers-row {
    list-style: none;
    margin: 0 auto;
    padding: 0;
    max-width: var(--max-width);
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: var(--space-md) 48px;
  }

  .customers-slot {
    display: flex;
    justify-content: center;
    align-items: center;
    min-width: 0;
  }

  .customers-logo {
    display: block;
    height: 92px;
    background: var(--brand-navy);
    -webkit-mask: var(--logo) center / contain no-repeat;
    mask: var(--logo) center / contain no-repeat;
  }

  .customers-text {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: .2rem;
  }

  .customers-name {
    font-family: var(--font-display);
    font-size: 1.6rem;
    font-weight: 600;
    line-height: 1.1;
    letter-spacing: -0.01em;
    color: var(--brand-navy);
  }

  .customers-note {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: .08em;
    text-transform: uppercase;
    color: var(--color-carbon-soft);
  }

  /* phone: stack, one entry per row, no marquee */
  @media (max-width: 640px) {
    .customers-row {
      flex-direction: column;
      gap: var(--space-md);
    }

    .customers-logo { height: 76px; }
    .customers-name { font-size: 1.35rem; }
  }
</style>
