---
// Site footer — approved prototype jufipai-relaunch (2026-11-04): navy, inline newsletter
// (no load-time modal), official lockup, "Built in the USA", neutral (no city or state).
// The newsletter posts to the same Apps Script endpoint EmailCapture/NewsletterModal used
// (type: 'subscribe'), so the real subscribe flow keeps working.
import { bookHref, CHROME, type Lang } from '../data/home';

interface Props {
  lang?: Lang;
}

const { lang = 'en' } = Astro.props;
const t = CHROME[lang];
const year = new Date().getFullYear();

// Status lines for the form (EN + ES, usted). Read by the client script from data attributes.
const msg =
  lang === 'es'
    ? {
        invalid: 'Escriba un correo completo, como usted@empresa.com.',
        pending: 'Enviando…',
        ok: 'Suscrito. Le llegará un correo cuando lancemos algo nuevo.',
        fail: 'No se envió. Revise su conexión y suscríbase de nuevo.',
      }
    : {
        invalid: 'Enter a full email address, like you@company.com.',
        pending: 'Sending…',
        ok: "Subscribed. You'll get one email when we ship something new.",
        fail: 'Not sent. Check your connection and subscribe again.',
      };
---

<footer class="site-footer">
  <div class="nl-inline">
    <div>
      <h2>{t.nlH}</h2>
      <p>{t.nlP}</p>
    </div>
    <form
      class="nl-form"
      id="nl-form"
      novalidate
      data-lang={lang}
      data-msg-invalid={msg.invalid}
      data-msg-pending={msg.pending}
      data-msg-ok={msg.ok}
      data-msg-fail={msg.fail}
    >
      <label for="nl-email">{t.nlL}</label>
      <input id="nl-email" type="email" name="email" autocomplete="email" placeholder={t.nlPh} required />
      <!-- Honeypot: must stay empty -->
      <input type="text" name="website" class="nl-honeypot" tabindex="-1" aria-hidden="true" autocomplete="off" />
      <button type="submit">{t.nlB}</button>
    </form>
    <p class="nl-note" id="nl-status" role="status" aria-live="polite"></p>
  </div>

  <div class="footer-inner">
    <div class="footer-left">
      <span class="footer-logo-wrap">
        <img class="brand-lockup" src="/brand/logo-lockup-dark.svg" width="168" height="32" alt="JufipAI" />
      </span>
      <span class="footer-location">{t.built}</span>
    </div>
    <div class="footer-right">
      <a href="https://www.linkedin.com/company/jufipai" target="_blank" rel="noopener noreferrer">LinkedIn</a>
      <a href={bookHref(lang, Astro.url.pathname)}>{t.touch}</a>
      <span class="footer-copy">&copy; {year}</span>
    </div>
  </div>
</footer>

<script src="../scripts/newsletter.ts"></script>

<style>
  .site-footer {
    margin-top: var(--space-2xl);
    padding: var(--space-xl) 0;
    background: var(--brand-navy);
  }

  /* ---------- inline newsletter (never a load-time modal) ---------- */
  .nl-inline {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: var(--space-lg) var(--space-md) var(--space-md);
    display: flex;
    gap: var(--space-lg);
    align-items: end;
    justify-content: space-between;
    flex-wrap: wrap;
    border-bottom: 1px solid rgba(197, 164, 78, .25);
  }

  .nl-inline h2 {
    font-family: var(--font-display);
    color: var(--text-on-dark);
    font-size: 1.375rem;
    margin: 0 0 .25rem;
  }

  .nl-inline p {
    margin: 0;
    color: var(--text-on-dark-muted);
    font-size: var(--text-small);
  }

  .nl-form {
    display: flex;
    gap: var(--space-xs);
    flex: 1 1 22rem;
    max-width: 28rem;
  }

  .nl-form label {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
  }

  .nl-form input[type='email'] {
    flex: 1;
    min-width: 0;
    min-height: 44px;
    font: inherit;
    font-size: var(--text-small);
    padding: .6rem 1rem;
    border-radius: var(--radius-pill);
    border: 1px solid rgba(197, 164, 78, .5);
    background: var(--bg-dark-elevated);
    color: var(--text-on-dark);
  }

  .nl-form input[type='email']::placeholder {
    color: var(--text-on-dark-muted);
  }

  .nl-honeypot {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    opacity: 0;
  }

  .nl-form button {
    min-height: 44px;
    font: inherit;
    font-size: var(--text-small);
    font-weight: 600;
    color: var(--brand-navy);
    background: var(--brand-gold);
    border: 0;
    border-radius: var(--radius-pill);
    padding: .6rem 1.25rem;
    cursor: pointer;
  }

  .nl-form button:hover {
    color: var(--brand-navy);
    background: var(--brand-gold-light);
  }

  .nl-form button:disabled {
    cursor: default;
    opacity: .7;
  }

  .nl-inline .nl-note {
    flex-basis: 100%;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    min-height: 1.2em;
  }

  /* ---------- bottom row ---------- */
  .footer-inner {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: var(--space-md) var(--space-md) 0;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-md);
  }

  .footer-left,
  .footer-right {
    display: flex;
    align-items: center;
    gap: var(--space-md);
  }

  .footer-logo-wrap {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }

  .footer-logo-wrap .brand-lockup {
    height: 32px;
  }

  .footer-location {
    font-size: var(--text-small);
    color: var(--text-on-dark-muted);
  }

  .footer-right a {
    font-size: var(--text-small);
    color: var(--brand-gold);
    transition: color var(--duration) var(--ease);
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }

  .footer-right a:hover {
    color: var(--brand-gold-light);
  }

  .footer-copy {
    font-size: var(--text-xs);
    color: var(--text-on-dark-muted);
  }

  @media (max-width: 640px) {
    .footer-inner {
      flex-direction: column;
      text-align: center;
    }
  }
</style>
