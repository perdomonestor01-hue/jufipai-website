---
// Homepage hero — approved prototype jufipai-relaunch (2026-11-04).
// Book-a-call prototype rev 3: the gold "Book a call" CTA is gone; booking is #book after the systems.
// Asymmetric 7/5 grid kept from the previous hero; copy, eyebrow and gold CTA are new.
// The papel-picado pattern, pull-quote marks and hand-drawn arrow are gone (not in the spec).


interface Props {
  eyebrow: string;
  headline: string;
  lede: string;
  see: string;
}

const { eyebrow, headline, lede, see } = Astro.props;
---

<section class="hero">
  <div class="hero-inner">
    <div class="hero-left">
      <span class="label-style hero-eyebrow">{eyebrow}</span>
      <h1 class="hero-headline">{headline}<span class="hero-period" aria-hidden="true">.</span></h1>
    </div>

    <div class="hero-right">
      <p class="hero-quote">{lede}</p>
      <div class="hero-actions">
        <a href="#systems" class="hero-cta">{see} <span class="arrow" aria-hidden="true">&darr;</span></a>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    padding: calc(var(--nav-height) + var(--space-2xl)) 0 var(--space-2xl);
    background: var(--color-papel);
    position: relative;
    overflow: hidden;
  }

  .hero-inner {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0 var(--space-md);
    display: grid;
    grid-template-columns: 7fr 5fr;
    gap: var(--space-xl);
    align-items: center;
    position: relative;
    z-index: 1;
  }

  .hero-left {
    min-width: 0;
  }

  .hero-eyebrow {
    display: block;
    margin-bottom: var(--space-sm);
  }

  .hero-headline {
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 6.2vw, 4.75rem);
    font-weight: 600;
    line-height: 1.02;
    letter-spacing: -0.025em;
    color: var(--color-carbon);
    margin: 0;
    max-width: 15ch;
  }

  .hero-period {
    color: var(--brand-gold);
    display: inline-block;
    transform: translateY(-0.05em);
  }

  .hero-right {
    position: relative;
    padding-top: var(--space-sm);
  }

  .hero-quote {
    font-family: var(--font-display);
    font-style: normal;
    font-size: clamp(1.25rem, 2vw, 1.5rem);
    font-weight: 400;
    line-height: 1.4;
    color: var(--color-carbon-soft);
    margin: 0 0 var(--space-sm);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-md);
    margin-top: var(--space-md);
  }


  .hero-cta {
    font-family: var(--font-body);
    font-size: var(--text-body-size);
    font-weight: 600;
    color: var(--brand-navy);
    text-decoration: underline;
    text-decoration-color: var(--brand-gold);
    text-decoration-thickness: 2px;
    text-underline-offset: 5px;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 44px;
    transition: color var(--duration-base) var(--ease-spring), gap var(--duration-base) var(--ease-spring);
  }

  .hero-cta:hover {
    color: var(--brand-navy);
    text-decoration-color: var(--brand-navy);
    gap: 0.75rem;
  }

  .arrow {
    transition: transform var(--duration-base) var(--ease-spring);
  }

  .hero-cta:hover .arrow {
    transform: translateY(2px);
  }

  @media (max-width: 900px) {
    .hero-inner {
      grid-template-columns: 1fr;
      gap: var(--space-lg);
    }
  }

  @media (max-width: 640px) {
    /* phone header wraps to two rows (lockup, nav): 136px measured (rev 7, no CTA, no EN/ES) */
    .hero {
      padding: calc(136px + var(--space-lg)) 0 var(--space-xl);
    }

    .hero-headline {
      font-size: clamp(2.25rem, 10vw, 3rem);
    }
  }
</style>
