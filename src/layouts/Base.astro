---
// Page shell. Relaunch 2026-11-04 (approved prototype jufipai-relaunch):
//  - English-only since 2026-11-11 (operator): no hreflang alternates, no language toggle
//  - og:image = synthetic 1200x627 brand card; theme-color navy
//  - JSON-LD Organization: name, url, logo ONLY (no people, no address, no city)
//  - CSP script-src 'self' (no inline script, no inline handlers): every client script is a
//    bundled file (astro.config.mjs sets assetsInlineLimit 0 so Vite never inlines one)
//  - no client router, no language toggle script, no load-time newsletter modal
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import type { Lang } from '../data/home';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  image?: string;
  lang?: Lang;
}

const SITE = 'https://jufipai.com';
const {
  title,
  description = 'Software that runs property, staffing and safety operations. We build it and we run it, every day.',
  image = `${SITE}/og/home-1200x627.png`,
  lang = 'en',
} = Astro.props;

// Full titles ("JufipAI · …") pass through; short ones get the brand suffix.
const fullTitle = title.includes('JufipAI') ? title : `${title} | JufipAI`;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);

const CSP = [
  "default-src 'self'",
  "script-src 'self'",
  "style-src 'self' 'unsafe-inline' https://fonts.googleapis.com",
  'font-src https://fonts.gstatic.com',
  "img-src 'self' https://images.unsplash.com data:",
  "connect-src 'self' https://script.google.com https://script.googleusercontent.com",
  "base-uri 'self'",
  "form-action 'self'",
  "object-src 'none'",
  'frame-src https://calendly.com',
].join('; ');
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#1b365d" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <meta http-equiv="Content-Security-Policy" content={CSP} />

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="JufipAI" />
    <meta property="og:locale" content={lang === 'es' ? 'es_US' : 'en_US'} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="627" />
    <meta property="og:image:alt" content="JufipAI" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />

    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'Organization',
        name: 'JufipAI',
        url: SITE,
        logo: `${SITE}/brand/logo.svg`,
      })}
    />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,500;0,9..144,600;0,9..144,700;1,9..144,400;1,9..144,500&family=Inter:wght@400;500;600;700&family=JetBrains+Mono&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <Header lang={lang} />
    <main>
      <slot />
    </main>
    <Footer lang={lang} />
  </body>
</html>
